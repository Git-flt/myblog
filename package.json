{
  "name": "myblog",
  "version": "1.0.0",
  "description": "个人技术写作站 —— 从运维视角看 AI 系统",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "new": "node scripts/new-post.mjs",
    "verify": "node scripts/verify-build.mjs",
    "build": "astro build && npm run build:search",
    "build:search": "pagefind --site dist --output-subdir _pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{ts,astro,css,md}\"",
    "legacy:publish": "node publish.js",
    "legacy:serve": "node server.js",
    "legacy:build": "node publish.js && npx pagefind --site . --output-subdir _pagefind",
    "legacy:test": "node test.js",
    "legacy:verify": "bash ./scripts/verify.sh"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.18.2",
    "gray-matter": "^4.0.3",
    "marked": "^9.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "eslint": "^8.56.0",
    "pagefind": "^1.0.4",
    "prettier": "^3.1.1",
    "typescript": "^5.9.3"
  }
}
