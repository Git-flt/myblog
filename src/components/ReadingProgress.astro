---
// 阅读进度条 + 回到顶部，来自原 js/reading-experience.js
---

<div class="reading-progress" id="readingProgress" aria-hidden="true"></div>
<button class="back-to-top" id="backToTop" type="button" aria-label="返回顶部">↑</button>

<script>
  const progress = document.getElementById('readingProgress');
  const backBtn = document.getElementById('backToTop');
  if (progress && backBtn) {
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? (window.scrollY / max) * 100 : 0;
      progress.style.width = `${Math.min(100, Math.max(0, ratio))}%`;
      backBtn.style.display = window.scrollY > 360 ? 'inline-flex' : 'none';
    };

    backBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
