---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/posts';
---

<BaseLayout title="页面不存在">
  <section class="articles">
    <div class="container">
      <h2 class="section-title">404 · 页面不存在</h2>
      <p class="page-intro">这个地址没有对应的内容，可能是链接过期或输入有误。</p>
      <p class="more-link">
        <a class="btn btn-primary" href={url()}>返回首页</a>
        <a class="btn btn-ghost" href={url('writing.html')}>浏览全部文章</a>
      </p>
    </div>
  </section>
</BaseLayout>
